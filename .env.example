# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repositorio.

# --- Sitio ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.velocecars.es
# "production" solo en el despliegue real: habilita la indexación en robots.txt
NEXT_PUBLIC_SITE_ENV=development

# --- Inventario ----------------------------------------------------------
# json (data/vehicles.json) | cms (ver src/lib/inventory/providers/cms-provider.ts)
INVENTORY_PROVIDER=json
# remote: fotos servidas desde DealCar · local: copias de public/vehicles (npm run inventory:images)
VEHICLE_IMAGES_SOURCE=remote
CMS_INVENTORY_URL=
CMS_TOKEN=

# Sincronización con DealCar (npm run inventory:import -- --live). Ver scripts/dealcar/import-stock.mjs
DEALCAR_DEALER_ID=1546932f-9962-4e19-954a-a5676adf72bd
DEALCAR_USER_ID=
DEALCAR_ACTION_ID=

# --- Formularios (Fase 3-4) ----------------------------------------------
RESEND_API_KEY=
CONTACT_FROM_EMAIL=web@velocecars.es
CONTACT_TO_EMAIL=contacto@velocecars.es
# Opcional: webhook n8n / CRM que recibe cada lead
LEADS_WEBHOOK_URL=

# --- Analítica (solo se carga tras consentimiento) -------------------------
NEXT_PUBLIC_GTM_ID=
